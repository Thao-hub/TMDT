@model IEnumerable<VayDuTiec>
@{
    ViewData["Title"] = "Thuê váy dự tiệc";
    var danhMuc = ViewBag.DanhMuc as List<DanhMucVay> ?? new List<DanhMucVay>();
}
<section class="khu-vuc-mo-dau">
    <div class="noi-dung-mo-dau">
        <div class="nhan-nho"><span></span> RENT • WEAR • REPEAT</div>
        <h1>Một chiếc váy,<br><em>ngàn khoảnh khắc</em></h1>
        <p>Khám phá những thiết kế dành cho buổi tiệc đáng nhớ — thuê chiếc váy bạn yêu, cho đúng ngày bạn cần.</p>
        <a class="nut" href="#bo-suu-tap">Khám phá bộ sưu tập <span>↓</span></a>
        <div class="cam-ket"><span>✦</span> Lịch thuê trực tuyến &nbsp; <span>✦</span> Giá thuê rõ ràng</div>
    </div>
    <div class="anh-mo-dau">
        <div class="khung-hinh-mo-dau">
            <div class="khung-anh-lon"></div>
        </div>
        <div class="the-noi"><span>THE OCCASION EDIT</span><strong>Find your<br>moment.</strong></div>
        <div class="trang-tri">✳</div>
    </div>
</section>
<section class="thanh-loi-ich">
    <div><span>01</span><strong>Chọn phong cách</strong><small>Thiết kế cho nhiều dịp đặc biệt</small></div>
    <div><span>02</span><strong>Chọn ngày thuê</strong><small>Kiểm tra lịch trước khi đặt</small></div>
    <div><span>03</span><strong>Sẵn sàng tỏa sáng</strong><small>Đặt thuê ngay trên website</small></div>
</section>
<section class="bo-suu-tap" id="bo-suu-tap">
    <div class="tieu-de-khu-vuc"><div><span class="nhan-nho">THE COLLECTION</span><h2>Váy dành cho <em>dịp đặc biệt</em></h2></div><p>Tìm chiếc váy phù hợp với phong cách và sự kiện của bạn.</p></div>
    <div class="bo-loc">
        <button class="nut-loc dang-chon" data-loai="tat-ca">Tất cả váy</button>
        @foreach (var muc in danhMuc) { <button class="nut-loc" data-loai="@muc.MaDanhMuc">@muc.TenDanhMuc</button> }
        <label class="tim-kiem"><span>⌕</span><input id="oTimKiem" type="search" placeholder="Tìm tên váy..." /></label>
    </div>
    <div class="luoi-vay" id="luoiVay">
        @foreach (var vay in Model)
        {
            var anh = vay.DanhSachHinhAnh
                .OrderByDescending(hinhAnh => hinhAnh.AnhChinh)
                .ThenBy(hinhAnh => hinhAnh.ThuTu)
                .Select(hinhAnh => hinhAnh.DuongDan)
                .FirstOrDefault();
            if (string.IsNullOrWhiteSpace(anh))
                anh = string.IsNullOrWhiteSpace(vay.HinhAnh) ? "https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=900&q=85" : vay.HinhAnh;
            <article class="the-vay" data-danh-muc="@vay.MaDanhMuc" data-ten="@vay.TenVay.ToLowerInvariant()">
                <a class="anh-vay" asp-controller="Vay" asp-action="ChiTiet" asp-route-id="@vay.MaVay">
                    <img src="@anh" alt="@vay.TenVay" loading="lazy" />
                    <span class="nhan-thue">CHO THUÊ</span>
                    <span class="nut-xem">Xem chi tiết ↗</span>
                </a>
                <div class="thong-tin-vay">
                    <div><span class="loai-vay">@(vay.DanhMuc?.TenDanhMuc ?? "Váy dự tiệc")</span><h3>@vay.TenVay</h3></div>
                    <div class="gia-vay"><strong>@vay.GiaThueMoiNgay.ToString("N0")₫</strong><small>/ ngày</small></div>
                </div>
                <div class="chi-tiet-nho"><span>Size @vay.KichCo</span><span>@vay.MauSac</span><span>Đặt cọc @vay.TienDatCoc.ToString("N0")₫</span></div>
            </article>
        }
    </div>
    <nav class="phan-trang-vay" id="phanTrangVay" aria-label="Phân trang bộ sưu tập"></nav>
    @if (!Model.Any()) { <div class="trong-rong">Chưa có váy nào trong hệ thống. Hãy thêm dữ liệu vào cơ sở dữ liệu SQL Server.</div> }
</section>
<section class="cach-thue" id="cach-thue">
    <div><span class="nhan-nho">SIMPLE & THOUGHTFUL</span><h2>Thuê váy thật <em>đơn giản</em></h2><p>Chọn thiết kế yêu thích, điền ngày thuê và thông tin liên hệ. Cửa hàng sẽ xác nhận đơn của bạn.</p></div>
    <div class="cac-buoc"><div><b>01</b><span><strong>Chọn chiếc váy</strong><small>Xem mẫu, size và giá thuê</small></span></div><div><b>02</b><span><strong>Chọn khoảng ngày</strong><small>Hệ thống kiểm tra lịch thuê</small></span></div><div><b>03</b><span><strong>Gửi yêu cầu thuê</strong><small>Nhận mã đơn sau khi gửi</small></span></div></div>
</section>
<script>
const cacTheVay = [...document.querySelectorAll('.the-vay')];
const khungPhanTrang = document.getElementById('phanTrangVay');
const soVayMoiTrang = 6;
let trangHienTai = 1;

document.querySelectorAll('.nut-loc').forEach(nut => nut.addEventListener('click', () => {
    document.querySelectorAll('.nut-loc').forEach(x => x.classList.remove('dang-chon'));
    nut.classList.add('dang-chon');
    locVay(true);
}));
document.getElementById('oTimKiem')?.addEventListener('input', () => locVay(true));
khungPhanTrang?.addEventListener('click', suKien => {
    const nut = suKien.target.closest('[data-trang]');
    if (!nut) return;
    trangHienTai = Number(nut.dataset.trang);
    locVay();
    document.getElementById('bo-suu-tap')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

function locVay(datLaiTrang = false) {
    const loai = document.querySelector('.nut-loc.dang-chon')?.dataset.loai || 'tat-ca';
    const tuKhoa = (document.getElementById('oTimKiem')?.value || '').toLowerCase().trim();
    const vayPhuHop = cacTheVay.filter(the =>
        (loai === 'tat-ca' || the.dataset.danhMuc === loai) && the.dataset.ten.includes(tuKhoa));
    const tongSoTrang = Math.max(1, Math.ceil(vayPhuHop.length / soVayMoiTrang));
    if (datLaiTrang) trangHienTai = 1;
    trangHienTai = Math.min(trangHienTai, tongSoTrang);
    const batDau = (trangHienTai - 1) * soVayMoiTrang;
    const tapDangHien = new Set(vayPhuHop.slice(batDau, batDau + soVayMoiTrang));
    cacTheVay.forEach(the => {
        the.hidden = !tapDangHien.has(the);
    });
    veNutPhanTrang(tongSoTrang);
}

function veNutPhanTrang(tongSoTrang) {
    if (!khungPhanTrang) return;
    khungPhanTrang.replaceChildren();
    const cacTrang = new Set([1, trangHienTai - 1, trangHienTai, trangHienTai + 1, tongSoTrang]);
    let trangTruoc = 0;
    [...cacTrang].filter(trang => trang >= 1 && trang <= tongSoTrang).sort((a, b) => a - b).forEach(trang => {
        if (trang - trangTruoc > 1) {
            const cham = document.createElement('span');
            cham.className = 'phan-trang-cham';
            cham.textContent = '…';
            khungPhanTrang.append(cham);
        }
        const nut = document.createElement('button');
        nut.type = 'button';
        nut.dataset.trang = String(trang);
        nut.textContent = String(trang);
        if (trang === trangHienTai) {
            nut.classList.add('dang-chon');
            nut.setAttribute('aria-current', 'page');
        }
        nut.setAttribute('aria-label', `Trang ${trang}`);
        khungPhanTrang.append(nut);
        trangTruoc = trang;
    });
    if (trangHienTai < tongSoTrang) {
        const nutSau = document.createElement('button');
        nutSau.type = 'button';
        nutSau.dataset.trang = String(trangHienTai + 1);
        nutSau.className = 'nut-sau';
        nutSau.textContent = 'Sau';
        nutSau.setAttribute('aria-label', 'Trang tiếp theo');
        khungPhanTrang.append(nutSau);
    }
}
locVay();
</script>
