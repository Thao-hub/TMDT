@model DonThue
@{
    ViewData["Title"] = "Đã nhận yêu cầu";
}
<section class="xac-nhan-trang">
    <div class="dau-tich">✓</div><span class="nhan-nho">YÊU CẦU ĐÃ ĐƯỢC GHI NHẬN</span>
    <h1>Cảm ơn bạn đã<br><em>chọn Tiệm Váy Mây</em></h1>
    <p>Yêu cầu thuê của bạn đã được lưu. Cửa hàng sẽ liên hệ để xác nhận lịch thuê và tiền đặt cọc.</p>
    <div class="thong-tin-don"><div><span>Mã đơn thuê</span><strong>#VT-@Model.MaDonThue.ToString("D5")</strong></div><div><span>Khách hàng</span><strong>@Model.HoTenKhach</strong></div><div><span>Khoảng ngày thuê</span><strong>@Model.NgayBatDauThue.ToString("dd/MM/yyyy") – @Model.NgayKetThucThue.ToString("dd/MM/yyyy")</strong></div><div><span>Trạng thái</span><strong class="trang-thai">@Model.TrangThai</strong></div><div><span>Tổng tiền thuê dự kiến</span><strong>@Model.TongTien.ToString("N0")₫</strong></div></div>
    <a class="nut" asp-controller="DonThue" asp-action="CuaToi">Xem đơn thuê của tôi <span>→</span></a>
</section>
