@model ThueVayDuTiec.Web.ViewModels.DangKyViewModel
@{
    ViewData["Title"] = "Đăng ký";
}
<section class="tai-khoan-trang">
    <form asp-action="DangKy" method="post" class="bieu-mau-tai-khoan">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <span class="nhan-nho">JOIN THE OCCASION</span>
        <h1>Tạo tài khoản</h1>
        <p>Đăng ký để đặt thuê váy và theo dõi đơn của bạn.</p>
        <div asp-validation-summary="ModelOnly" class="loi-bieu-mau"></div>
        <label asp-for="HoTen"></label><input asp-for="HoTen" autocomplete="name" /><span asp-validation-for="HoTen" class="loi-bieu-mau"></span>
        <label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="loi-bieu-mau"></span>
        <label asp-for="SoDienThoai"></label><input asp-for="SoDienThoai" autocomplete="tel" /><span asp-validation-for="SoDienThoai" class="loi-bieu-mau"></span>
        <label asp-for="MatKhau"></label><input asp-for="MatKhau" autocomplete="new-password" /><span asp-validation-for="MatKhau" class="loi-bieu-mau"></span>
        <label asp-for="XacNhanMatKhau"></label><input asp-for="XacNhanMatKhau" autocomplete="new-password" /><span asp-validation-for="XacNhanMatKhau" class="loi-bieu-mau"></span>
        <button class="nut nut-day-du" type="submit">Đăng ký</button>
        <p class="lien-ket-tai-khoan">Đã có tài khoản? <a asp-action="DangNhap" asp-route-returnUrl="@ViewData["ReturnUrl"]">Đăng nhập</a></p>
    </form>
</section>
